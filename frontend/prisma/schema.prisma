generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bank_accounts {
  id             Int            @id @default(autoincrement())
  user_id        Int?
  bank_name      String         @db.VarChar(100)
  account_type   String?        @db.VarChar(50)
  account_number String?        @db.VarChar(50)
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  users          users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  budget_goals   budget_goals[]
  statements     statements[]
  transactions   transactions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model budget_goals {
  id              Int            @id @default(autoincrement())
  user_id         Int?
  name            String         @db.VarChar(200)
  target_amount   Decimal        @db.Decimal(12, 2)
  current_amount  Decimal?       @default(0) @db.Decimal(12, 2)
  monthly_target  Decimal?       @db.Decimal(12, 2)
  deadline        DateTime       @db.Date
  timeline_type   String?        @db.VarChar(20)
  priority        Int?           @default(1)
  category_id     Int?
  bank_account_id Int?
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  bank_accounts   bank_accounts? @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories      categories?    @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model categories {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique @db.VarChar(100)
  icon                   String?                  @db.VarChar(50)
  color                  String?                  @db.VarChar(20)
  budget_goals           budget_goals[]
  monthly_summaries      monthly_summaries[]
  recurring_transactions recurring_transactions[]
  transactions           transactions[]
}

model households {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users[]
}

model monthly_summaries {
  id              Int         @id @default(autoincrement())
  user_id         Int?
  month           DateTime    @db.Date
  total_income    Decimal?    @default(0) @db.Decimal(12, 2)
  total_spending  Decimal?    @default(0) @db.Decimal(12, 2)
  savings_rate    Decimal?    @default(0) @db.Decimal(5, 2)
  top_category_id Int?
  created_at      DateTime?   @default(now()) @db.Timestamp(6)
  categories      categories? @relation(fields: [top_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model recurring_transactions {
  id                  Int         @id @default(autoincrement())
  user_id             Int?
  merchant            String      @db.VarChar(100)
  merchant_normalized String?     @db.VarChar(100)
  amount              Decimal     @db.Decimal(12, 2)
  category_id         Int?
  frequency           String?     @db.VarChar(20)
  last_seen           DateTime?   @db.Date
  next_expected       DateTime?   @db.Date
  is_active           Boolean?    @default(true)
  created_at          DateTime?   @default(now()) @db.Timestamp(6)
  categories          categories? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model statements {
  id                 Int            @id @default(autoincrement())
  user_id            Int?
  bank_account_id    Int?
  bank_name          String?        @db.VarChar(100)
  statement_month    DateTime?      @db.Date
  storage_url        String?
  status             String?        @default("PENDING") @db.VarChar(20)
  error_message      String?
  total_transactions Int?           @default(0)
  processing_time    Decimal?       @db.Decimal(8, 2)
  created_at         DateTime?      @default(now()) @db.Timestamp(6)
  bank_accounts      bank_accounts? @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions       transactions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id                  Int            @id @default(autoincrement())
  user_id             Int?
  statement_id        Int?
  bank_account_id     Int?
  date                DateTime       @db.Date
  description         String?
  merchant            String?        @db.VarChar(100)
  merchant_normalized String?        @db.VarChar(100)
  amount              Decimal        @db.Decimal(12, 2)
  type                String?        @db.VarChar(10)
  category_id         Int?
  confidence          Decimal?       @db.Decimal(4, 2)
  hash                String?        @unique @db.VarChar(64)
  needs_review        Boolean?       @default(false)
  is_duplicate        Boolean?       @default(false)
  created_at          DateTime?      @default(now()) @db.Timestamp(6)
  bank_accounts       bank_accounts? @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories          categories?    @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statements          statements?    @relation(fields: [statement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @db.VarChar(100)
  email                  String                   @unique @db.VarChar(100)
  password               String                   @db.VarChar(255)
  household_id           Int?
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  bank_accounts          bank_accounts[]
  budget_goals           budget_goals[]
  monthly_summaries      monthly_summaries[]
  recurring_transactions recurring_transactions[]
  statements             statements[]
  transactions           transactions[]
  households             households?              @relation(fields: [household_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
